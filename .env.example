# Copy these names to the LIVE backend .env and fill in live values.
# Do not copy development credentials to production.
# PORT=3002
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=replace_with_live_database_user
# DB_PASSWORD=replace_with_live_database_password
# DB_NAME=replace_with_live_database_name
# JWT_SECRET=replace_with_a_long_random_secret

# FRONTEND_URL=https://mydesk.technicmentors.com/
# PASSWORD_RESET_URL=https://mydesk.technicmentors.com//reset-password
RESEND_API_KEY=replace_with_live_resend_key
FROM_EMAIL=MyDesk <noreply@replace-with-live-domain.example>

# SMTP is used for notifications, employee credentials, and payroll email.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
# SMTP_USE_TLS=true

# Required only when using Cloudinary-backed uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional persistent filesystem locations for uploads.
CHAT_UPLOAD_DIR=
PROJECT_UPLOAD_DIR=

# Optional browser binary for PDF generation if auto-detection fails.
PUPPETEER_EXECUTABLE_PATH=
